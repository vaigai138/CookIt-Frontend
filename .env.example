# ─────────────────────────────────────────────────────────────
# CookIT — Environment variables (set these in Vercel → Settings → Environment Variables)
# Copy to .env.local for local development with `vercel dev`.
# NEVER commit real secrets. This file documents the keys only.
# ─────────────────────────────────────────────────────────────

# ── Email / Lead delivery (Gmail SMTP via nodemailer) ──
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), NOT your login password.
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
# Where lead/contact notifications are delivered (comma-separated for multiple).
RECIPIENT_EMAIL=leads@cookit.example
# Optional CC recipients (comma-separated).
CC_EMAILS=

# ── AI chatbot + Solution Architect wizard (OpenRouter free model) ──
OPENROUTER_API_KEY=
# A free model id, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Admin panel / Blog CMS (Phase 5) ──
# Secret used to sign admin JWTs (any long random string).
JWT_SECRET=
# GitHub repo used as the content store, format: owner/repo
GITHUB_REPO=vaigai138/CookIt-Frontend
GITHUB_BRANCH=main
# A GitHub Personal Access Token with repo contents read/write.
GITHUB_TOKEN=
# Fallback admin credentials (used if content/admin-credentials.json is absent).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2026
ADMIN_EMAIL=
